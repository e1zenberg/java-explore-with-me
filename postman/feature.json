{
  "info": {
    "name": "Subscriptions Feature (Postman) - Fixed Order",
    "_postman_id": "7c7d5a4e-2c3b-4a3f-bf11-aaaabbbbcccc",
    "description": "Исправлено: публикация события выполняется ПОСЛЕ его создания. Коллекция для проверки фитчи подписок и ленты событий подписок.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Admin",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Music\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Category created', function(){",
                  "  pm.response.to.have.status(201);",
                  "  pm.environment.set('categoryId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create User A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Alice Sub\",\"email\":\"alice.sub@example.com\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User A created', function(){",
                  "  pm.response.to.have.status(201);",
                  "  pm.environment.set('userAId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create User B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Bob Target\",\"email\":\"bob.target@example.com\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User B created', function(){",
                  "  pm.response.to.have.status(201);",
                  "  pm.environment.set('userBId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User B",
      "item": [
        {
          "name": "Create Event",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 3*60*60*1000);",
                  "function pad(n){return n<10?'0'+n:n}",
                  "const ts = d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+' '+pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds());",
                  "pm.environment.set('futureDate', ts);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Event created', function(){",
                  "  pm.response.to.have.status(201);",
                  "  pm.environment.set('eventId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userBId}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userBId}}",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"annotation\":\"Live concert announcement with special guests\",\"category\":{{categoryId}},\"description\":\"A great live music event.\",\"eventDate\":\"{{futureDate}}\",\"location\":{\"lat\":55.751244,\"lon\":37.618423},\"paid\":false,\"participantLimit\":0,\"requestModeration\":false,\"title\":\"Live Concert\"}"
            }
          }
        },
        {
          "name": "Admin publishes Event (after creation)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "events",
                "{{eventId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"stateAction\":\"PUBLISH_EVENT\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Event published', function(){",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.state).to.eql('PUBLISHED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "Subscribe A -> B",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/users/{{userAId}}/subscriptions?targetId={{userBId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userAId}}",
                "subscriptions"
              ],
              "query": [
                {
                  "key": "targetId",
                  "value": "{{userBId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Subscribed', function(){",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Feed for A",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/{{userAId}}/subscriptions/feed?from=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userAId}}",
                "subscriptions",
                "feed"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Feed contains published event', function(){",
                  "  pm.response.to.have.status(200);",
                  "  var list = pm.response.json();",
                  "  var ids = list.map(e => e.id);",
                  "  pm.expect(ids).to.include(parseInt(pm.environment.get('eventId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List A Subscriptions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/{{userAId}}/subscriptions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userAId}}",
                "subscriptions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Contains B', function(){",
                  "  pm.response.to.have.status(200);",
                  "  var list = pm.response.json();",
                  "  var ids = list.map(u => u.id);",
                  "  pm.expect(ids).to.include(parseInt(pm.environment.get('userBId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List B Followers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/{{userBId}}/subscriptions/followers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userBId}}",
                "subscriptions",
                "followers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Contains A', function(){",
                  "  pm.response.to.have.status(200);",
                  "  var list = pm.response.json();",
                  "  var ids = list.map(u => u.id);",
                  "  pm.expect(ids).to.include(parseInt(pm.environment.get('userAId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unsubscribe A -> B",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/users/{{userAId}}/subscriptions?targetId={{userBId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userAId}}",
                "subscriptions"
              ],
              "query": [
                {
                  "key": "targetId",
                  "value": "{{userBId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unsubscribed', function(){",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Feed after Unsubscribe",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/{{userAId}}/subscriptions/feed?from=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userAId}}",
                "subscriptions",
                "feed"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Feed is empty or does not include event', function(){",
                  "  pm.response.to.have.status(200);",
                  "  var list = pm.response.json();",
                  "  var ids = list.map(e => e.id);",
                  "  pm.expect(ids).to.not.include(parseInt(pm.environment.get('eventId')));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}